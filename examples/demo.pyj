# pyj demo: break lines and indent however you like
import math; from dataclasses import dataclass

@dataclass
class Point { x: float; y: float
  def dist(self, other) -> float { return math.hypot(self.x - other.x,
                                                     self.y - other.y) } }

def fib(n) { a, b = 0, 1; for _ in range(n) { a, b = b, a + b }; return a }

def classify(n) {
if n < 0 { return "negative" } else if n == 0 { return "zero" }
    else { return "positive" }
}

config = {"name": "pyj", "tags": {"a", "b"}}   # dicts and sets work as usual
if "pyj" in {config["name"]} { print(f"hello {config['name']}! {{literal}} {len({1, 2})}") }

total = 1 +
    2 +
    3
print(total)

p = Point(0, 0); q = Point(3, 4)
print(p.dist(q), [fib(i) for i in range(10)], classify(-5), classify(0), classify(7))

try { 1 / 0 } except ZeroDivisionError as e { print("caught:", e) } finally { print("finally") }

def http(code) { match code { case 200 | 201 { return "ok" } case _ { return "err" } } }
print(http(200), http(500))

class Empty {}
while False {}
squares = {k: k * k for k in range(4)}
print(squares)
